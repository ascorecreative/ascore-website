# Copy to .env.server only on the approved server. Never use VITE_ for secrets.
ASCORE_ORIGIN=http://127.0.0.1:5173
ASCORE_API_PORT=8787
ASCORE_DB_PATH=server/data/portal.sqlite
# NODE_ENV=production requires HTTPS ASCORE_ORIGIN and explicit registration opt-in.
ASCORE_ALLOW_REGISTRATION=0
# No accounts or grants are seeded. Enable only during approved private activation.
ASCORE_ALLOW_ADMIN_SETUP=0
ASCORE_ADMIN_SETUP_GRANTS={}
# Grant structure per reserved username: {"tokenHash":"SHA256_OF_PRIVATE_TOKEN","expiresAt":"ISO_UTC_EXPIRY"}
# Supported names: aswinfrn, sachindinesh. Choose passwords privately in the setup form.
# Separate, approved website credentials: assistant connector access is not reused.
ZOHO_API_ORIGIN=
ZOHO_CRM_ORGANIZATION_ID=
ZOHO_CRM_ACCESS_TOKEN=
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_ACCESS_TOKEN=
ASCORE_ENABLE_ZOHO_WRITES=0
# Map local pipeline states to actual CRM picklist values after checking the org schema.
ZOHO_CRM_LEAD_STATUS_MAP={}
# Verify the Books item/currency/tax IDs in the selected organization before enabling sync.
ZOHO_BOOKS_ITEM_ID=
ZOHO_BOOKS_CURRENCY_CODE=
ZOHO_BOOKS_TAX_MAP={}

# Hostinger production uses the integrated MariaDB adapter; local development uses SQLite.
# Populate only after approval for a NEW dedicated database/user. Server-only.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
ASCORE_ALLOW_SCHEMA_SETUP=0
# Public enquiries remain saved locally until separate approved email/CRM setup.
ASCORE_ENABLE_ENQUIRY_DELIVERY=0

# Hostinger private runtime environment; never place production secrets in dist/public.
# NODE_ENV=production; ASCORE_ORIGIN=https://ascore.ae; ASCORE_DATABASE=mariadb
# PORT is supplied by the hosting runtime. Framework: Other; entry file: server/index.mjs; build: npm run build; output: dist.
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_ACCOUNTS_ORIGIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Frontend-only Vite publication: use this explicit public build flag until backend activation.
# This is not a secret. Remove it/rebuild in API mode when the production backend is approved.
# VITE_ASCORE_RELEASE_MODE=static
