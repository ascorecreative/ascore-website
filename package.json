{
  "name": "ascore-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/prerender-courses.mjs && node scripts/precompress.mjs",
    "lint": "oxlint src",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env.server server/index.mjs",
    "dev:all": "node server/dev.mjs",
    "test:portal": "node --test server/*.test.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "build:static": "VITE_ASCORE_RELEASE_MODE=static npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1",
    "vite-plugin-glsl": "^1.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
